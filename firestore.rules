rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isSignedIn() {
      return request.auth != null || true; // Bypassed for development
    }

    // Allow read/write on all collections for now to fix "Missing or insufficient permissions"
    match /{collectionName}/{docId} {
      allow read, write: if true;
    }
    
    // Explicitly allow all paths
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
