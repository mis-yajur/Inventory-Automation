    "PluginModule": {
      "title": "PluginModule",
      "description": "Modular plugins",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "version": { "type": "string" },
        "description": { "type": "string" },
        "enabled": { "type": "boolean" },
        "author": { "type": "string" }
      },
      "required": ["id", "name", "enabled"]
    }
