  "firestore": {
    "items": { "schema": { "$ref": "#/entities/Item" }, "description": "Inventory items" },
    "categories": { "schema": { "$ref": "#/entities/Category" }, "description": "Categories" },
    "units": { "schema": { "$ref": "#/entities/Unit" }, "description": "Units" },
    "departments": { "schema": { "$ref": "#/entities/Department" }, "description": "Departments" },
    "stores": { "schema": { "$ref": "#/entities/Store" }, "description": "Stores" },
    "suppliers": { "schema": { "$ref": "#/entities/Supplier" }, "description": "Suppliers" },
    "ledger": { "schema": { "$ref": "#/entities/StockLedgerEntry" }, "description": "Ledger" },
    "stockInReceipts": { "schema": { "$ref": "#/entities/StockInReceipt" }, "description": "GRN" },
    "materialIssues": { "schema": { "$ref": "#/entities/MaterialIssue" }, "description": "MIN" },
    "materialReturns": { "schema": { "$ref": "#/entities/MaterialReturn" }, "description": "MRN" },
    "stockTransfers": { "schema": { "$ref": "#/entities/StockTransfer" }, "description": "Transfers" },
    "stockAdjustments": { "schema": { "$ref": "#/entities/StockAdjustment" }, "description": "Adjustments" },
    "monthlyClosings": { "schema": { "$ref": "#/entities/MonthlyClosing" }, "description": "Monthly Closings" },
    "alerts": { "schema": { "$ref": "#/entities/AlertNotification" }, "description": "Alerts" },
    "auditLogs": { "schema": { "$ref": "#/entities/AuditLog" }, "description": "Audit Logs" },
    "users": { "schema": { "$ref": "#/entities/UserRole" }, "description": "Users" },
    "settings": { "schema": { "$ref": "#/entities/CompanySettings" }, "description": "Settings" },
    "plugins": { "schema": { "$ref": "#/entities/PluginModule" }, "description": "Plugins" }
  }
}
